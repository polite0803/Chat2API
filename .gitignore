# Dependencies
node_modules/

# Build outputs
out/
dist/
build/entitlements.mac.plist

# Channel pack worker bundle (built by scripts/build-channel-pack.mjs;
# the .wasm / LICENSE / NOTICE next to it are vendored and must stay tracked)
resources/channel-pack/worker.mjs

# TypeScript
*.tsbuildinfo
src/**/*.js
src/**/*.d.ts
# ... except hand-written ambient declarations (the rules above target compiled output)
!src/main/types/*.d.ts
electron.vite.config.js
electron.vite.config.d.ts
vite.config.js
vite.config.d.ts

# Vite temp files
*.mjs.tmp
electron.vite.config.*.mjs

# Logs
logs/
!src/renderer/src/components/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
.workbuddy/
.trae/
*.swp
*.swo
.codex/
CLAUDE.md

# Environment
.env
.env.local
.env.*.local

# Test
coverage/

# Misc
*.pem
*.p12

# Next.js experimental app (not part of Electron build)
src/renderer/next-app/

# Backup
backup/

# Local reference material dropped in by tooling (not part of the app)
.uploads/

# npx artifact cache created in the repo root by the local npm config
.npm-cache/
